{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blockive-premium-addon-for-block/tb-product-sku",
	"version": "0.1.0",
	"title": "Product SKU",
	"category": "blockive-template",
	"icon": "id",
	"description": "Displays the current WooCommerce product's SKU dynamically. Blockive Template Builder only.",
	"usesContext": [ "postId", "postType" ],
	"textdomain": "blockive-premium-addon-for-block",
	"attributes": {
		"label": {
			"type": "string",
			"default": "SKU:"
		},
		"hideIfEmpty": {
			"type": "boolean",
			"default": true
		},
		"textColor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
