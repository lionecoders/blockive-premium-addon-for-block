{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blockive-premium-addon-for-block/funfact",
	"version": "0.1.0",
	"title": "Blockive Fun Fact",
	"category": "bpafb-widgets",
	"icon": "chart-bar",
	"description": "Animated statistics/counter block.",
	"attributes": {
		"items": {
			"type": "array",
			"default": [
				{
					"id": "1",
					"number": "1000",
					"prefix": "",
					"suffix": "+",
					"title": "Happy Clients"
				},
				{
					"id": "2",
					"number": "120",
					"prefix": "",
					"suffix": "",
					"title": "Awards Won"
				},
				{
					"id": "3",
					"number": "500",
					"prefix": "",
					"suffix": "+",
					"title": "Projects Completed"
				}
			]
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"numberColor": {
			"type": "string",
			"default": "#4f46e5"
		},
		"textColor": {
			"type": "string",
			"default": "#333333"
		},
		"duration": {
			"type": "number",
			"default": 1000
		},
		"gap": {
			"type": "number",
			"default": 20
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./style-index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"supports": {
		"anchor": true
	}
}
