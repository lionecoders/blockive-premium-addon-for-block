{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blockive-premium-addon-for-block/testimonial",
	"version": "0.1.0",
	"title": "Blockive Testimonial",
	"category": "bpafb-widgets",
	"icon": "format-quote",
	"description": "Customer testimonials slider block.",
	"attributes": {
		"testimonials": {
			"type": "array",
			"default": [
				{
					"id": "1",
					"name": "John Doe",
					"designation": "CEO",
					"image": "",
					"content": "This is an amazing product! Highly recommended.",
					"rating": 5
				}
			]
		},
		"style": {
			"type": "string",
			"default": "style1"
		},
		"showRating": {
			"type": "boolean",
			"default": true
		},
		"showDots": {
			"type": "boolean",
			"default": true
		},
		"showArrows": {
			"type": "boolean",
			"default": true
		},
		"textColor": {
			"type": "string",
			"default": "#333333"
		},
		"bgColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"arrowIcon": {
			"type": "string",
			"default": "angle"
		},
		"imagePosition": {
			"type": "string",
			"default": "top"
		},
		"imageStyle": {
			"type": "string",
			"default": "circle"
		},
		"textAlign": {
			"type": "string",
			"default": "center"
		},
		"autoPlay": {
			"type": "boolean",
			"default": true
		},
		"autoPlaySpeed": {
			"type": "number",
			"default": 3000
		},
		"arrowColor": {
			"type": "string",
			"default": "#333333"
		},
		"arrowBgColor": {
			"type": "string",
			"default": "transparent"
		},
		"infiniteLoop": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./index.css",
	"viewScript": "file:./view.js"
}