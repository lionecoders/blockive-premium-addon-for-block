{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockive-premium-addon-for-block/post-grid",
  "version": "0.1.0",
  "title": "Blockive Post Grid",
  "category": "bpafb-widgets",
  "icon": "grid-view",
  "description": "Dynamic post grid/listing block.",
  "supports": {
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "anchor": true
  },
  "attributes": {
    "columns": {
      "type": "number",
      "default": 3
    },
    "postsPerPage": {
      "type": "number",
      "default": 9
    },
    "orderBy": {
      "type": "string",
      "default": "date"
    },
    "order": {
      "type": "string",
      "default": "desc"
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "showDate": {
      "type": "boolean",
      "default": true
    },
    "showAuthor": {
      "type": "boolean",
      "default": true
    },
    "postType": {
      "type": "string",
      "default": "post"
    },
    "dateFormat": {
      "type": "string",
      "default": ""
    },
    "titleColor": {
      "type": "string",
      "default": ""
    },
    "dateColor": {
      "type": "string",
      "default": ""
    },
    "authorColor": {
      "type": "string",
      "default": ""
    },
    "excerptColor": {
      "type": "string",
      "default": ""
    },
    "cardBgColor": {
      "type": "string",
      "default": ""
    },
    "cardBorderRadius": {
      "type": "number",
      "default": 8
    },
    "cardBorderColor": {
      "type": "string",
      "default": ""
    },
    "cardBorderWidth": {
      "type": "number",
      "default": 0
    },
    "cardBorderStyle": {
      "type": "string",
      "default": "none"
    }
  },
  "render": "file:./render.php",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./index.css"
}