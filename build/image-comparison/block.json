{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockive-premium-addon-for-block/image-comparison",
  "version": "0.1.0",
  "title": "Blockive Image Comparison",
  "category": "bpafb-widgets",
  "icon": "format-image",
  "description": "Before/after image comparison slider block.",
  "attributes": {
    "beforeImage": {
      "type": "string",
      "default": ""
    },
    "afterImage": {
      "type": "string",
      "default": ""
    },
    "beforeLabel": {
      "type": "string",
      "default": "Before"
    },
    "afterLabel": {
      "type": "string",
      "default": "After"
    },
    "showLabels": {
      "type": "boolean",
      "default": true
    },
    "labelColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "labelBackgroundColor": {
      "type": "string",
      "default": "rgba(0, 0, 0, 0.65)"
    },
    "labelPosition": {
      "type": "string",
      "default": "top"
    },
    "separatorColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "arrowColor": {
      "type": "string",
      "default": "#555555"
    },
    "sliderPosition": {
      "type": "number",
      "default": 50
    },
    "height": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./index.css",
  "viewScript": "file:./view.js"
}