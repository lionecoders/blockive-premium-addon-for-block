{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockive-premium-addon-for-block/mailchimp",
  "version": "0.1.0",
  "title": "Blockive MailChimp",
  "category": "bpafb-widgets",
  "icon": "email",
  "description": "MailChimp newsletter subscription block.",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Subscribe to Our Newsletter"
    },
    "subtitle": {
      "type": "string",
      "default": "Get the latest updates delivered to your inbox"
    },
    "placeholderText": {
      "type": "string",
      "default": "Enter your email"
    },
    "buttonText": {
      "type": "string",
      "default": "Subscribe"
    },
    "titleColor": {
      "type": "string",
      "default": ""
    },
    "subtitleColor": {
      "type": "string",
      "default": ""
    },
    "inputBgColor": {
      "type": "string",
      "default": "#f8f9fa"
    },
    "buttonBgColor": {
      "type": "string",
      "default": "#f0f0f0"
    },
    "buttonTextColor": {
      "type": "string",
      "default": "#000000"
    },
    "inputBorderRadius": {
      "type": "number",
      "default": 0
    },
    "buttonBorderRadius": {
      "type": "number",
      "default": 2
    },
    "buttonHoverBgColor": {
      "type": "string",
      "default": "#e0e0e0"
    },
    "buttonHoverTextColor": {
      "type": "string",
      "default": "#000000"
    },
    "showInputIcon": {
      "type": "boolean",
      "default": false
    },
    "inputIconBgColor": {
      "type": "string",
      "default": "#e9ecef"
    },
    "inputIconColor": {
      "type": "string",
      "default": "#000000"
    },
    "showButtonIcon": {
      "type": "boolean",
      "default": false
    },
    "inputBorderWidth": {
      "type": "number",
      "default": 0
    },
    "inputBorderColor": {
      "type": "string",
      "default": "transparent"
    },
    "buttonBorderWidth": {
      "type": "number",
      "default": 1
    },
    "buttonBorderColor": {
      "type": "string",
      "default": "#767676"
    },
    "formAction": {
      "type": "string",
      "default": ""
    },
    "formGap": {
      "type": "number",
      "default": 0
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./index.css",
  "supports": {
    "anchor": true
  }
}