{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockive-premium-addon-for-block/testimonial",
  "version": "0.1.0",
  "title": "Blockive Testimonial",
  "category": "bpafb-widgets",
  "icon": "format-quote",
  "description": "Customer testimonials slider block.",
  "attributes": {
    "testimonials": {
      "type": "array",
      "default": [
        {
          "id": "1",
          "name": "John Doe",
          "designation": "CEO",
          "image": "",
          "content": "This is an amazing product! Highly recommended.",
          "rating": 5
        },
        {
          "id": "2",
          "name": "Alina Doe",
          "designation": "Designer",
          "image": "",
          "content": "The quality is good and the delivery was so fast.",
          "rating": 4
        },
        {
          "id": "3",
          "name": "Aria Smith",
          "designation": "Manager",
          "image": "",
          "content": "Excellent service and fast delivery. The product is exactly as described.",
          "rating": 5
        }
      ]
    },
    "style": {
      "type": "string",
      "default": "style1"
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "showRating": {
      "type": "boolean",
      "default": true
    },
    "showDots": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "textColor": {
      "type": "string",
      "default": "#333333"
    },
    "descColor": {
      "type": "string",
      "default": "#333333"
    },
    "positionColor": {
      "type": "string",
      "default": "#999999"
    },
    "bgColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "arrowIcon": {
      "type": "string",
      "default": "angle"
    },
    "imagePosition": {
      "type": "string",
      "default": "top"
    },
    "imageStyle": {
      "type": "string",
      "default": "circle"
    },
    "textAlign": {
      "type": "string",
      "default": "center"
    },
    "autoPlay": {
      "type": "boolean",
      "default": true
    },
    "autoPlaySpeed": {
      "type": "number",
      "default": 3000
    },
    "arrowColor": {
      "type": "string",
      "default": "#333333"
    },
    "arrowBgColor": {
      "type": "string",
      "default": "transparent"
    },
    "infiniteLoop": {
      "type": "boolean",
      "default": true
    },
    "cardBorderWidth": {
      "type": "number",
      "default": 0
    },
    "cardBorderRadius": {
      "type": "number",
      "default": 8
    },
    "cardBorderColor": {
      "type": "string",
      "default": "#dddddd"
    },
    "enableBoxShadow": {
      "type": "boolean",
      "default": true
    },
    "dotColor": {
      "type": "string",
      "default": "#dddddd"
    },
    "activeDotColor": {
      "type": "string",
      "default": "#4f46e5"
    },
    "boxShadowHOffset": {
      "type": "number",
      "default": 0
    },
    "boxShadowVOffset": {
      "type": "number",
      "default": 2
    },
    "boxShadowBlur": {
      "type": "number",
      "default": 8
    },
    "boxShadowSpread": {
      "type": "number",
      "default": 0
    },
    "boxShadowColor": {
      "type": "string",
      "default": "rgba(0, 0, 0, 0.1)"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./index.css",
  "viewScript": "file:./view.js"
}